# Plantilla de .gitconfig (sin datos personales en [user]).
# Copia este archivo a ~/.gitconfig y rellena [user] con tu nombre/email,
# o usa un ~/.gitconfig.local (ignorado por git) con [user] e inclúyelo
# desde aquí con:
#   [include]
#       path = ~/.gitconfig.local

[user]
        name = Tu Nombre
        email = tu@email.com
[alias]
        lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
        s = status
        ss = status -sb
[filter "lfs"]
        clean = git-lfs clean -- %f
        smudge = git-lfs smudge -- %f
        process = git-lfs filter-process
        required = true